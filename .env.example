# Copy to .env and adjust. Never commit .env.

# --- LLMs (Ollama runs on the host, not in Docker) ---
# From the host. Inside Docker, compose overrides this with host.docker.internal.
OLLAMA_BASE_URL=http://localhost:11434
# ~3B model for routing / classification
SMALL_MODEL=qwen2.5:3b
# ~7-8B tool-calling instruct model for planning / writing (~4.7 GB RAM)
LARGE_MODEL=qwen2.5:7b
# Embeddings for semantic memory
EMBED_MODEL=nomic-embed-text

# --- Agents ---
# local | a2a
RESEARCH_MODE=local
# For RESEARCH_MODE=a2a: where the research service runs (`make a2a-research`).
A2A_RESEARCH_URL=http://localhost:8100/

# --- Memory ---
MEMORY_ENABLED=true

# --- Optional graph memory: `make up-graph` starts Neo4j. Local-only password, min 8 chars. ---
NEO4J_PASSWORD=change-me-local
# Uncomment to use it (when the app runs on the host; in Docker the service name is used):
# NEO4J_URI=bolt://localhost:7687

# --- Docker only. `make setup` sets this: the absolute path of ./workspace on this machine. ---
# HOST_WORKSPACE=C:/path/to/orchestraos/workspace
